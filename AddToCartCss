:root {
    --secondary: #1a1a1a;
    --light: #f8f9fa;
    --dark: #343a40;
    --text: #555;
}

header {
    background-color: rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    transition: all 0.3s ease;
}

.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
}

.navbar1 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    height: 5px;
}

.logo {
    font-size: 28px;
    font-weight: 700;
    color: red;
    text-decoration: none;
    display: flex;
    align-items: center;
}
        
.logo i {
    margin-right: 10px;
    font-size: 32px;
}

.nav-links {
    display: flex;
    list-style: none;
}
        
.nav-links li {
    margin-left: 30px;
    position: relative;
}

.nav-links button {
    margin-left: 30px;
    position: relative;
}
        
.nav-links a {
    text-decoration: none;
    color: var(--secondary);
    font-weight: 500;
    font-size: 16px;
    transition: color 0.3s;
    padding: 5px 0;
}
        
.nav-links a:hover {
    color: red;
}
        
.nav-links a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: red;
     transition: width 0.3s;
}

.nav-links button:hover {
    color: red;
}
        
.nav-links button::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: red;
     transition: width 0.3s;
}
        
.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

.A {
    margin-top: 150px;
    margin-left: 20%;
    margin-right: 20%;
}

.cart-item {
    display: grid;
    grid-template-columns: 100px 1fr 140px 120px 50px;
    align-items: center;
    gap: 15px;
    padding: 20px 0;
    border-bottom: 1px solid #eee;
}

.cart-img img {
    width: 90px;
    height: 90px;
    border-radius: 14px;
    object-fit: cover;
}

.cart-name {
    font-weight: 600;
}

.cart-qty {
    display: flex;
    align-items: center;
    gap: 8px;
}

.cart-qty button {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #e4002b;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

.cart-qty input {
    height: 32px;
    width: 40px;
    text-align: center;
    border-radius: 6px;
    border: 1px solid #ccc;
}

.cart-price {
    font-weight: 600;
}

.remove-btn {
    background: transparent;
    border: none;
    color: red;
    font-size: 20px;
    cursor: pointer;
}
